# ─── Production ────────────────────────────────────────────────
# Prod mode: connects to live Spring Boot backend
VITE_APP_MODE=prod

# Set this to your deployed backend URL before building:
#   Railway:     https://paysonic-backend.up.railway.app
#   Render:      https://paysonic-backend.onrender.com
#   Same-domain: leave empty (Nginx proxies /api/ automatically)
VITE_API_BASE_URL=https://paysonic1-production.up.railway.app
